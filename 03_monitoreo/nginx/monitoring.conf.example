# /etc/nginx/sites-available/monitoring.conf
# Reemplazar DOMINIO, IPs whitelist y rutas certbot según tu entorno.
# NO commitear con IPs/dominios reales.

# IPs permitidas (jefe + oficina + Tailscale exit si aplica)
# geo $allowed_ip { default 0; 203.0.113.10 1; 100.x.x.x/32 1; }

server {
    listen 80;
    server_name monitor.ejemplo-empresa.com;

    # Certbot: descomentar tras certificado
    # return 301 https://$host$request_uri;

    location / {
        # allow 203.0.113.10;
        # deny all;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# server {
#     listen 443 ssl http2;
#     server_name monitor.ejemplo-empresa.com;
#     ssl_certificate /etc/letsencrypt/live/monitor.ejemplo-empresa.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/monitor.ejemplo-empresa.com/privkey.pem;
#     ...
# }
